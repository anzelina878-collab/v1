LicenseUrl": {"value": "https://creativecommons.org/licenses/by-sa/2.0", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "cc-by-sa-2.0", "source": "commons-templates", "hidden": ""}}}]}, "140221400": {"pageid": 140221400, "ns": 6, "title": "File:VX-23 F-35B approaches HMS Prince of Wales.jpg", "imagerepository": "local", "imageinfo": [{"size": 6162311, "width": 4800, "height": 2700, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/VX-23_F-35B_approaches_HMS_Prince_of_Wales.jpg/1920px-VX-23_F-35B_approaches_HMS_Prince_of_Wales.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 1600, "thumbheight": 900, "responsiveUrls": {"2": "https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/VX-23_F-35B_approaches_HMS_Prince_of_Wales.jpg/3840px-VX-23_F-35B_approaches_HMS_Prince_of_Wales.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"}, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/VX-23_F-35B_approaches_HMS_Prince_of_Wales.jpg/1920px-VX-23_F-35B_approaches_HMS_Prince_of_Wales.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "decoding": "async", "loading": "lazy", "width": 1600, "height": 900, "srcset": "https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/VX-23_F-35B_approaches_HMS_Prince_of_Wales.jpg/3840px-VX-23_F-35B_approaches_HMS_Prince_of_Wales.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"}, "url": "https://upload.wikimedia.org/wikipedia/commons/2/2a/VX-23_F-35B_approaches_HMS_Prince_of_Wales.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:VX-23_F-35B_approaches_HMS_Prince_of_Wales.jpg", "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=140221400", "extmetadata": {"DateTime": {"value": "2023-11-06 15:13:35", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "VX-23 F-35B approaches HMS Prince of Wales", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Taken with Nikon D850|Air Test and Evaluation Squadron 23 (United States Navy)|PD US Navy|F-number f/5.6|Exposure time 1/1000 sec|Taken on missing SDC inception|October 2023 in aviation|CC-PD-Mark|Photographs taken on 2023-10-11|Royal Navy in 2023|October 2023 at sea|Lockheed Martin F-35B Lightning II on final approach|HMS Prince of Wales (R09) general views of", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "F-35 test pilot Marine Maj. Paul Gucwa from <a href=\"https://en.wikipedia.org/wiki/Air_Test_and_Evaluation_Squadron_Two_Three\" class=\"extiw\" title=\"w:Air Test and Evaluation Squadron Two Three\">Air Test and Evaluation Squadron Two Three</a> (VX-23), <a href=\"https://en.wikipedia.org/wiki/Naval_Air_Warfare_Center_Aircraft_Division\" class=\"extiw\" title=\"w:Naval Air Warfare Center Aircraft Division\">Naval Air Warfare Center Aircraft Division</a> (NAWCAD), flies an <a href=\"https://en.wikipedia.org/wiki/F-35B_Lightning_II\" class=\"extiw\" title=\"w:F-35B Lightning II\">F-35B Lightning II</a> fighter aircraft towards <a href=\"https://en.wikipedia.org/wiki/HMS_Prince_of_Wales_(R09)\" class=\"extiw\" title=\"en:HMS Prince of Wales (R09)\">HMS\u00a0<i>Prince of Wales</i>\u00a0(R09)</a> aircraft carrier of the <a href=\"https://en.wikipedia.org/wiki/Royal_Navy\" class=\"extiw\" title=\"w:Royal Navy\">Royal Navy</a> (RN) in the Western Atlantic, 11 October 2023.  Gucwa will embark with a detachment from the <a href=\"https://en.wikipedia.org/wiki/Patuxent_River_F-35_Integrated_Test_Force\" class=\"extiw\" title=\"w:Patuxent River F-35 Integrated Test Force\">Patuxent River F-35 Integrated Test Force</a> (ITF), to conduct developmental test phase 3 (DT-3) sea trials with the specially instrumented, short take-off vertical landing variant of the stealth jet aboard one of the <a href=\"https://en.wikipedia.org/wiki/United_Kingdom\" class=\"extiw\" title=\"w:United Kingdom\">United Kingdoms</a> (UK) largest warships.  The <a href=\"https://en.wikipedia.org/wiki/Queen_Elizabeth-class_aircraft_carrier\" class=\"extiw\" title=\"w:Queen Elizabeth-class aircraft carrier\">Queen Elizabeth-class aircraft carrier</a> (QEC) HMS <i>Prince of Wales</i> (R09)'s participation in <a href=\"https://en.wikipedia.org/wiki/WESTLANT_23\" class=\"extiw\" title=\"w:WESTLANT 23\">WESTLANT 23</a> encompasses a range of U.K. and U.S. naval aircraft trials in the Western Atlantic throughout the autumn of <a href=\"https://en.wikipedia.org/wiki/2023_in_aviation\" class=\"extiw\" title=\"w:2023 in aviation\">2023</a>.\nThe HMS <i>Prince of Wales</i> continues to push the boundaries of <a href=\"https://en.wikipedia.org/wiki/naval_aviation\" class=\"extiw\" title=\"w:naval aviation\">naval aviation</a> capabilities and operations from QEC aircraft carriers, including increasing the range and lethality of F-35 operations.  The U.K. is the only Tier I partner in the F-35 Joint Strike Fighter (JSF) Programme.  U.K. and U.S. interactions during this deployment are characterized by cooperation, and reinforce international relationships, as well as enhance interoperability between the U.S. Navy and Royal Navy.  The F-35 Joint Program Office is the <a href=\"https://en.wikipedia.org/wiki/U.S._Department_of_Defense\" class=\"extiw\" title=\"w:U.S. Department of Defense\">U.S. Department of Defense</a>'s focal point for the 5th-generation strike aircraft for the Navy, Air Force, Marines, and our allies.  The F-35 is the premier multi-mission, 5th-generation weapon system.  Its ability to collect, analyze and share data, is a force multiplier that enhances all assets in the battle space: with stealth technology, advanced sensors, weapons capacity, and range.  The F-35 has been operational since July 2015, and is the most lethal, survivable, and interoperable fighter aircraft ever built.  (US Navy photo by Dane Wiedmann)", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "Taken on\u00a011 October 2023, 07:59:18", "source": "commons-desc-page"}, "Credit": {"value": "<a rel=\"nofollow\" class=\"external free\" href=\"https://www.dvidshub.net/image/8066054/f-35b-lands-aboard-hms-prince-wales\">https://www.dvidshub.net/image/8066054/f-35b-lands-aboard-hms-prince-wales</a>", "source": "commons-desc-page"}, "Artist": {"value": "<a href=\"https://en.wikipedia.org/wiki/US_Navy\" class=\"extiw\" title=\"w:US Navy\">US Navy</a> photo by Dane Wiedmann", "source": "commons-desc-page"}, "LicenseShortName": {"value": "Public domain", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Public domain", "source": "commons-desc-page"}, "AttributionRequired": {"value": "false", "source": "commons-desc-page", "hidden": ""}, "Copyrighted": {"value": "False", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "pd", "source": "commons-templates", "hidden": ""}}}]}}}}